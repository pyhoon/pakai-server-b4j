# Rename this file to .env and modify the values to your settings

# SSL Keystores
SSL_PORT=8000
SSL_ENABLED=False
SSL_KEYSTORE_DIR=
SSL_KEYSTORE_FILE=keystore.p12
SSL_KEYSTORE_PASSWORD=xxxxxxxx

# Email Settings
SMTP_PORT=465/587
SMTP_ENABLED=False
SMTP_USESSL=True/False
SMTP_SERVER=smtp.google.com
SMTP_USERNAME=yourname@gmail.com
SMTP_PASSWORD=16-character-Google-App-Password