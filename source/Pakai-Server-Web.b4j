#Region  Macros
'1 - Create $APPNAME$.b4j
'2 - Open $APPNAME$.b4j
'    -> Remove all macros for Step 1 to 5
'3 - Create Pakai Server Web (6.80).b4xtemplate
'4 - Copy to B4J Additional Libraries folder
'5 - Check Release folder
#Macro: Title, Step 1, ide://run?file=%COMSPEC%&Args=/c&Args=copy&Args=%PROJECT%\Pakai-Server-Web.b4j&Args=%PROJECT%\$APPNAME$.b4j
#Macro: Title, Step 2, ide://run?File=%WINDIR%\explorer.exe&Args=%PROJECT%\$APPNAME$.b4j
#Macro: Title, Step 3, ide://run?file=%JAVABIN%\jar.exe&WorkingDirectory=..&Args=-cMf&Args=%PROJECT%\..\release\Pakai+Server+Web+(6.80).b4xtemplate&Args=Files&Args=$APPNAME$.*&Args=ProductsHandler.bas&Args=CategoriesHandler.bas&Args=*Model.bas&Args=*View.bas&Args=HttpsFilter.bas&Args=MH.bas&Args=ORM.bas&Args=libs.json&Args=res.json&Args=..\LICENSE&Args=Objects\www\assets\img&Args=Objects\www\assets\css\main.css&Args=Objects\www\assets\js\app.js
#Macro: Title, Step 4, ide://run?file=%COMSPEC%&Args=/c&Args=copy&Args=%PROJECT%\..\release\Pakai+Server+Web+(6.80).b4xtemplate&Args=%ADDITIONAL%
#Macro: Title, Step 5, ide://run?file=%WINDIR%\SysWOW64\explorer.exe&Args=%PROJECT%\..\release
'For release
#Macro: Title, ModelGenerator, ide://run?file=%ADDITIONAL%\modgen.jar&Args=ide_state.json&codesync=True
#Macro: Title, GetLibraries, ide://run?file=%ADDITIONAL%\..\B4X\libget.jar&Args=%PROJECT%&librariesrefresh=True
'#Macro: Title, Backup, ide://run?file=%JAVABIN%\jar.exe&WorkingDirectory=..&Args=-cMf&Args=%PROJECT_NAME%.zip&Args=Files&Args=Objects\www&Args=Objects\config.ini&Args=Objects\LICENSE&Args=*.bas&Args=*.b4j&Args=*.b4j.meta&Args=libs.json
'#Macro: Title, Objects, ide://run?file=%WINDIR%\SysWOW64\explorer.exe&Args=%PROJECT%\Objects
'#Macro: Title, Distribute, ide://run?file=%JAVABIN%\jar.exe&WorkingDirectory=../Objects&Args=-cMf&Args=Dist.zip&Args=www&Args=*.jar&Args=*.ini
#End Region
'Download tools:
'<link>libget.jar|https://github.com/pyhoon/libget-b4j/releases/download/v2.60/libget.jar</link> | <link>modgen.jar|https://github.com/pyhoon/modgen-b4j/releases/download/v0.60/modgen.jar</link>
Sub Process_Globals
	Public DB	As MiniORM
	Public App	As EndsMeet
	Public Const APP_VERSION As String = "1.00"
	Type AlertInfo (Message As String, Status As String)
	Type ToastInfo (Entity As String, Action As String, Message As String, Status As String)
End Sub

' <link>Open in browser|http://127.0.0.1:8080</link>
' <link>Donate|https://paypal.me/aeric80/</link> | <link>Forum|https://www.b4x.com/android/forum/threads/web-project-template-pakai-server-v6.169224/</link> | <link>GitHub|https://github.com/pyhoon/pakai-server-b4j</link>
Sub AppStart (Args() As String)
	App.Initialize
	App.LoadConfig
	App.LogEnabled = True
	#If Release
	'App.ssl.Enabled = True
	'App.RedirectToHttps = True
	#End If
	
	' Frontend using HTMX and AlpineJS
	App.Get("", "ProductsHandler")
	App.Get("/categories", "CategoriesHandler")
	App.Rest("/hx/products/*", "ProductsHandler")
	App.Rest("/hx/categories/*", "CategoriesHandler")
	
	App.Start
	App.LogStartupMessage
	App.ctx.Put("VERSION", APP_VERSION)
	Log($"App version: ${APP_VERSION}"$)
	Log($"Open the following URL from your web browser"$)
	Log(App.ServerUrl)
	
	ORM.InitDatabase
	StartMessageLoop
End Sub

Public Sub CurrentDateTime As String
	Dim CurrentDateFormat As String = DateTime.DateFormat
	DateTime.DateFormat = "yyyy-MM-dd HH:mm:ss"
	DateTime.SetTimeZone(0)
	Dim Now As String = DateTime.Date(DateTime.Now)
	DateTime.DateFormat = CurrentDateFormat
	Return Now
End Sub

Public Sub CreateAlertInfo (Message As String, Status As String) As AlertInfo
	Dim t1 As AlertInfo
	t1.Initialize
	t1.Message = Message
	t1.Status = Status
	Return t1
End Sub

Public Sub CreateToastInfo (Entity As String, Action As String, Message As String, Status As String) As ToastInfo
	Dim t1 As ToastInfo
	t1.Initialize
	t1.Entity = Entity
	t1.Action = Action
	t1.Message = Message
	t1.Status = Status
	Return t1
End Sub